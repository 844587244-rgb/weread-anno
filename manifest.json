{
  "manifest_version": 3,
  "name": "微信悦读 · Anno 伴读",
  "version": "0.32.0.3",
  "description": "微信读书划线回看、精读旁注和 AI 追问。基于微信悦读。",
  "default_locale": "zh_CN",
  "homepage_url": "https://reader.chesterlee.cn",
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://i.weread.qq.com/*",
    "https://api.deepseek.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.moonshot.cn/*",
    "https://open.bigmodel.cn/*",
    "https://ark.cn-beijing.volces.com/*",
    "https://api.siliconflow.cn/*",
    "https://reader.chesterlee.cn/*",
    "https://*.tcloudbase.com/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/donate/wechat.png",
        "assets/donate/alipay.png",
        "assets/feedback/wechat.png",
        "assets/wechat-mp/qrcode.png"
      ],
      "matches": [
        "*://weread.qq.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://weread.qq.com/*"
      ],
      "js": [
        "anno/canvas.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://weread.qq.com/*"
      ],
      "css": [
        "content.css",
        "modules/stats.css",
        "modules/notes.css",
        "modules/tts.css",
        "modules/official.css",
        "modules/finder.css",
        "modules/home-shelf.css",
        "modules/support-center.css",
        "modules/backup.css",
        "modules/help.css",
        "modules/reviews.css",
        "modules/sync-notes.css",
        "anno/reader.css"
      ],
      "js": [
        "modules/stats.js",
        "modules/tts.js",
        "modules/notes.js",
        "modules/sync-notes.js",
        "modules/official.js",
        "modules/pinyin-data.js",
        "modules/finder.js",
        "modules/home-shelf.js",
        "modules/support-center.js",
        "modules/backup.js",
        "modules/help.js",
        "modules/reviews.js",
        "modules/telemetry.js",
        "content.js",
        "anno/locate.js",
        "anno/reader.js"
      ],
      "run_at": "document_end"
    }
  ],
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "anno/panel.html"
  }
}
